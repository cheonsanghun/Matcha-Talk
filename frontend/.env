# VITE_API_BASE_URL을 비우거나 /api로 두면 프런트엔드가 제공되는 도메인의 /api 경로를 사용합니다.
# ngrok 등으로 프런트만 외부에 공개할 때 반드시 /api 형태를 유지해야 프록시를 통해 백엔드에 도달합니다.
VITE_API_BASE_URL=/api

# 백엔드를 별도 도메인이나 IP로 직접 호출하고 싶다면 아래 줄의 주석을 풀어 절대 URL을 지정합니다.
# 예시) VITE_API_BASE_URL=http://localhost:8080/api

# 백엔드 API 서버 주소 (개발 환경)
VITE_DEV_BACKEND_ORIGIN=http://localhost:8080

# 로컬 네트워크에서 접속을 허용할 추가 호스트 (예: 192.168.0.165)
VITE_DEV_ALLOWED_HOST=192.168.0.165

# WebSocket/STOMP 엔드포인트 경로
VITE_WS_PATH=/ws-stomp

# 개발 서버 호스트/포트 (기본값: 0.0.0.0:5173)
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=5173

# HMR(WebSocket) 연결 정보를 명시적으로 지정하려면 아래 값을 설정하세요.
# 예: VITE_DEV_HMR_HOST=192.168.0.165
VITE_DEV_HMR_HOST=192.168.0.165
VITE_DEV_HMR_PORT=5173
VITE_DEV_HMR_PROTOCOL=wss

# 개발용 HTTPS 인증서 경로 (선택 사항)
# mkcert 등으로 발급한 key/cert 파일 경로를 지정하세요.
VITE_DEV_HTTPS_KEY=./dev-key.pem
VITE_DEV_HTTPS_CERT=./dev-cert.pem

# TURN/STUN 서버 설정 (선택 사항)
# 정적 자격 증명을 사용할 경우:
 VITE_TURN_URLS=stun:stun.relay.metered.ca:80,turn:seoul.relay.metered.ca:80,turn:seoul.relay.metered.ca:80?transport=tcp,turn:seoul.relay.metered.ca:443,turns:seoul.relay.metered.ca:443?transport=tcp
 VITE_TURN_USERNAME=1ef2a88d0379a8048e08c767
 VITE_TURN_CREDENTIAL=Lj1tozp0QAevEsUd
# Metered 등에서 제공하는 REST API로 동적 자격 증명을 가져올 경우:
 VITE_TURN_CREDENTIALS_URL=https://matchatalk.metered.live/api/v1/turn/credentials
 VITE_TURN_API_KEY=2199f562de270d20a2f0cc5134b9bae7dc0d